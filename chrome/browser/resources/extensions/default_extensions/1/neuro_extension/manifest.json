{
  "manifest_version": 3,
  "key": "",
  "name": "Neuro Extension",
  "version": "1.0",
  "description": "Displays neuro-style text overlay on all web pages",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ],
      "css": [ "styles.css" ],
      "run_at": "document_end"
    }
  ]
}